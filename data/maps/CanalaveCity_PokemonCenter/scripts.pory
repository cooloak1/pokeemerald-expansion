mapscripts CanalaveCity_PokemonCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CanalaveCity_PokemonCenter_MapScript_OnTransition
}

script CanalaveCity_PokemonCenter_MapScript_OnTransition {
    setrespawn(HEAL_LOCATION_CANALAVE_CITY)
}

script CanalaveCity_PokemonCenter_EventScript_Nurse {
    setvar(VAR_0x800B, LOCALID_CANALAVE_NURSE)
    call(Common_EventScript_PkmnCenterNurse)
    waitmessage
	waitbuttonpress
	release
	end
}