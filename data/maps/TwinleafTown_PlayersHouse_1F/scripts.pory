mapscripts TwinleafTown_PlayersHouse_1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: TwinleafTown_PlayersHouse_1F_MapScript_OnTransition

	
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_PLAYERS_MOM_STATE, 0: TwinleafTown_PlayersHouse_1F_EventScript_Mom_BarryLeft
		VAR_PLAYERS_MOM_STATE, 4: TwinleafTown_PlayersHouse_1F_Mom_AfterBattle

	]
}

script TwinleafTown_PlayersHouse_1F_MapScript_OnTransition {
	setrespawn(HEAL_LOCATION_TWINLEAF_TOWN)
	if(var(VAR_PLAYERS_MOM_STATE) == 4){
		setobjectxyperm(LOCALID_MOM, 1, 3)
		applymovement(OBJ_EVENT_ID_PLAYER, face_up)
	}
}

script TwinleafTown_PlayersHouse_1F_EventScript_Mom_BarryLeft {
	lock
	applymovement(1, Common_Movement_ExclamationMark)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_down))
	applymovement(1, moves(walk_in_place_up))
	waitmovement(0)
	delay(48)
	applymovement(1, moves(
		walk_up * 1
		walk_right * 3
		walk_up * 3
	))
	waitmovement(0)
	msgbox(TwinleafTown_PlayersHouse_1F_Text_BarryAlreadyLeft)
	closemessage
	applymovement(1, moves(
		walk_down * 3
		walk_left * 3
		walk_down * 1
		walk_in_place_up
	))
	waitmovement(0)
	setvar(VAR_PLAYERS_MOM_STATE, 1)
	release
	end
}

script TwinleafTown_PlayersHouse_1F_EventScript_ExitTrigger {
	lock
	applymovement(1, moves(walk_in_place_down))
	waitmovement(0)
	delay(48)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
	waitmovement(0)
	msgbox(TwinleafTown_PlayersHouse_1F_Text_DontGoInTallGrass)
	closemessage
	setvar(VAR_PLAYERS_MOM_STATE, 2)
}

script TwinleafTown_PlayersHouse_1F_Mom_TalkedTo {
	switch (var(VAR_PLAYERS_MOM_STATE)) {
		case 0:
		case 1:
			msgbox(TwinleafTown_PlayersHouse_1F_Text_YouKnowBarry, MSGBOX_NPC)
		case 2:
			msgbox(TwinleafTown_PlayersHouse_1F_Text_TakeCare, MSGBOX_NPC)
		case 3:
			msgbox(TwinleafTown_PlayersHouse_1F_Text_IsntBarryWaitingForYou, MSGBOX_NPC)
		case 4:
		case 5:
			msgbox(TwinleafTown_PlayersHouse_1F_Text_RunningShoes, MSGBOX_NPC)
		case 6:
			msgbox(TwinleafTown_PlayersHouse_1F_Text_TakeARest, MSGBOX_NPC)
	}
}

script TwinleafTown_PlayersHouse_1F_Mom_AfterBattle {
	lock
	delay(24)
	applymovement(LOCALID_PLAYERS_MOM, moves(
		walk_left
		face_up
	))
	waitmovement(0)
	delay(24)
	applymovement(LOCALID_PLAYERS_MOM, moves(
		walk_right * 3
		walk_down * 2
		walk_right * 3
		walk_down * 2
		walk_in_place_left
	))
	delay(48)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(
		walk_in_place_right
	))
	delay(48)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(
		walk_right * 3
		walk_down * 2
		walk_right
	))
	waitmovementall
	msgbox(TwinleafTown_PlayersHouse_1F_Text_AfterBattle)
	
	delay(24)
	msgbox(TwinleafTown_PlayersHouse_1F_Text_PutTheseOn)
	setflag(FLAG_SYS_B_DASH)
	setflag(FLAG_RECEIVED_RUNNING_SHOES)
	setvar(VAR_PLAYERS_MOM_STATE, 5)
	release
	end

}

script TwinleafTown_PlayersHouse_1F_EventScript_Counter {
	msgbox(TwinleafTown_PlayersHouse_1F_Text_Counter, MSGBOX_SIGN)
}

script TwinleafTown_PlayersHouse_1F_EventScript_Fridge {
	msgbox(TwinleafTown_PlayersHouse_1F_Text_Fridge, MSGBOX_SIGN)
}

script TwinleafTown_PlayersHouse_1F_EventScript_Sink {
	msgbox(TwinleafTown_PlayersHouse_1F_Text_Sink, MSGBOX_SIGN)
}

text TwinleafTown_PlayersHouse_1F_Text_BarryAlreadyLeft {
	format("Mom: {PLAYER}!\pBarry already left.\pI don't know what it was about, but he sure was in a hurry!")
}

text TwinleafTown_PlayersHouse_1F_Text_YouKnowBarry {
	format("Mom: You know how impatient Barry is.\pHe took off before I could even ask what it was about.")
}

text TwinleafTown_PlayersHouse_1F_Text_DontGoInTallGrass {
	format("Mom: Oh, yes!\n{PLAYER}!\pDon't go into the tall grass. Wild Pokemon might attack you.\pIt would be OK if you had your own Pokemon, but you don't, so...\pWell, take care, sweetie!")
}

text TwinleafTown_PlayersHouse_1F_Text_TakeCare {
	format("Mom: Bye-bye {PLAYER}!\nYou take care now!")
}

text TwinleafTown_PlayersHouse_1F_Text_IsntBarryWaitingForYou {
	format("Mom: What is it, dear?\nIsn't Barry waiting for you?")
}

text TwinleafTown_PlayersHouse_1F_Text_QuickRest {
	format("Mom: Welcome home, {PLAYER}.\nAre you and your Pokemon healthy?\nTake a quick rest, dear.")
}

text TwinleafTown_PlayersHouse_1F_Text_TreatPokemonWithKindness {
	format("Mom: {PLAYER}.\pListen. Always treat your Pokemon with kindness.\pYour Pokemon work hard, not for themselves, but for you!")
}

text TwinleafTown_PlayersHouse_1F_Text_Counter {
	format("This is where Mom does all her delicious cooking.")
}

text TwinleafTown_PlayersHouse_1F_Text_Fridge {
	format("Mom's favorite dessert is in the refrigerator")
}

text TwinleafTown_PlayersHouse_1F_Text_Sink {
	format("Mom's kitchen is spotless!\nYou can see your face on the floor!")
}

text TwinleafTown_PlayersHouse_1F_Text_AfterBattle {
	format("Mom: What’s the matter, dear?\p...\pWow.\nThat’s what happened to you?\pYou and Barry are lucky to have met Prof. Rowan.\pImagine if you didn’t...\pI wouldn’t like to think what the wild Pokémon might have done to you two.\p{PLAYER}, go see Prof. Rowan, and thank him properly for your Pokémon.\pHis lab is in Sandgem Town, isn’t it?\pNow that you have your own Pokémon, the tall grass won’t be so threatening.")
}

text TwinleafTown_PlayersHouse_1F_Text_PutTheseOn {
	format("Oh, I know!\n{PLAYER}, put these on.\p{PLAY_SE MUS_OBTAIN_ITEM}{PLAYER} recieved a pair of {COLOR RED}Running Shoes{COLOR DARK_GRAY}!{WAIT_SE}\pGoing to Sandgem Town is like an adventure in itself, right?\pWith those Running Shoes, you can get to faraway places much faster.\pOK...\nLet me read the instructions...\p“Press the B Button and dash about faster than ever before!\p“Put on the Running Shoes and blaze new trails of adventure!”\pWell, isn’t that just nifty!")
}

text TwinleafTown_PlayersHouse_1F_Text_RunningShoes {
	format("Mom: I’ll read you the instructions for the Running Shoes...\p“Press the B Button and dash about faster than ever before!\p“Put on the Running Shoes and blaze new trails of adventure!”\pWell, isn’t that just nifty!")
}

text TwinleafTown_PlayersHouse_1F_Text_TakeARest {
	format("Mom: Welcome home, {PLAYER}.\nAre you and your Pokémon healthy?\pTake a quick rest, dear.\p")
}