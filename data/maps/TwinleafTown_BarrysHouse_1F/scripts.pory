mapscripts TwinleafTown_BarrysHouse_1F_MapScripts {

}

script TwinleafTown_BarrysHouse_1F_EventScript_RivalsMom {
	switch(var(VAR_BARRY_STATE)) {
		case 1:
			msgbox(TwinleafTown_BarrysHouse_1F_Text_LookingForRival, MSGBOX_NPC)
		case 2:
		case 3:
			if(flag(FLAG_TALKED_TO_RIVALS_MOM)) {
				msgbox(TwinleafTown_BarrysHouse_1F_Text_BarryRoute201, MSGBOX_NPC)
			} else {
				msgbox(TwinleafTown_BarrysHouse_1F_Text_RocketedOff, MSGBOX_NPC)
				setflag(FLAG_TALKED_TO_RIVALS_MOM)
			}
		case 4:
			msgbox(TwinleafTown_BarrysHouse_1F_Text_FriendsWithPokemon, MSGBOX_NPC)
		default:
			msgbox(TwinleafTown_BarrysHouse_1F_Text_GreatestTrainer, MSGBOX_NPC)

	}
}

text TwinleafTown_BarrysHouse_1F_Text_LookingForRival {
	format("Barry’s mom: Oh, hi, {PLAYER}.\pAre you looking for Barry?\pHe was gone for a second, but then he came running right back home.\pHe just can’t sit still, that boy.\nI wonder who he takes after? ")
}
text TwinleafTown_BarrysHouse_1F_Text_RocketedOff {
	format("Barry's mom: That kid rocketed off again like usual.\pI’d guess he would be out on Route 201 by now?\pHe just can’t sit still, that boy.\nI wonder who he takes after?")
}

text TwinleafTown_BarrysHouse_1F_Text_BarryRoute201 {
	format("Barry’s mom: My Barry should be out on Route 201 by now.\pHe just can’t sit still, that boy.\nI wonder who he takes after?")
}

text TwinleafTown_BarrysHouse_1F_Text_FriendsWithPokemon {
	format("Barry's mom: Oh, you’ve become friends with a Pokémon, too.")
}

text TwinleafTown_BarrysHouse_1F_Text_GreatestTrainer {
	format("Barry's Mom: My Barry took off like a rocket as usual.\pHe was shouting something about becoming the greatest Trainer ever...\pHe just can’t sit still, that boy.\nI wonder who he takes after?")
}