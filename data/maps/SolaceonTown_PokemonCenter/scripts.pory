mapscripts SolaceonTown_PokemonCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: SolaceonTown_PokemonCenter_MapScript_OnTransition
}

script SolaceonTown_PokemonCenter_MapScript_OnTransition {
    setrespawn(HEAL_LOCATION_SOLACEON_TOWN)
}

script SolaceonTown_PokemonCenter_EventScript_Nurse {
    setvar(VAR_0x800B, LOCALID_SOLACEON_NURSE)
    call(Common_EventScript_PkmnCenterNurse)
    waitmessage
	waitbuttonpress
	release
	end
}